# ─── API Configuration (REQUIRED) ────────────────────────────
# External SaaS API base URL (backend that serves blogs, services, FAQs)
NEXT_PUBLIC_API_BASE_URL=https://wehoware-saas.vercel.app

# Client ID for the public API (scopes all requests to this client)
NEXT_PUBLIC_CLIENT_ID=1910ea08-b8ae-4968-8e69-c9b7c5e7bc78

# ─── Site Configuration (REQUIRED) ───────────────────────────
# Public-facing site URL (used for SEO, canonical URLs, sitemaps)
NEXT_PUBLIC_SITE_URL=https://www.birchmountautorepair.com

# ─── Analytics (REQUIRED) ────────────────────────────────────
# Google Tag Manager container ID
NEXT_PUBLIC_GTM_CONTAINER_ID=GTM-TGG5L77T

# ─── API Configuration (OPTIONAL — sensible defaults built in) ──
# Request timeout in milliseconds for external API calls (default: 10000)
# NEXT_PUBLIC_API_TIMEOUT_MS=10000

# Maximum retry attempts for failed API calls (default: 2)
# NEXT_PUBLIC_API_MAX_RETRIES=2

# ISR revalidation time in seconds (default: 60)
# NEXT_PUBLIC_API_REVALIDATE_SECONDS=60

# ISR long revalidation for sitemaps/static params (default: 3600)
# NEXT_PUBLIC_API_REVALIDATE_LONG_SECONDS=3600

# ─── Email (Contact Form) ────────────────────────────────────
# Gmail credentials for nodemailer (contact form submissions)
GMAIL_USER=
GMAIL_APP_PASSWORD=
